@@ -217,6 +222,45 @@
 static struct soap *soap;
 
 ServiceContext service_ctx;
+static bool auth_loaded = false;
+static void load_auth(const char *path)
+{
+    int fd = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK);
+    struct stat st;
+    char data[164];
+    if(fd < 0 || fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size < 4 || st.st_size >= (off_t)sizeof(data))
+        daemon_error_exit("Invalid ONVIF credential file\n");
+    ssize_t count = read(fd, data, sizeof(data));
+    close(fd);
+    if(count != st.st_size) daemon_error_exit("Invalid ONVIF credential file\n");
+    std::string value(data, count);
+    size_t split = value.find('\n');
+    if(split < 1 || split > 32 || value.back() != '\n' || value.find('\n', split+1) != value.size()-1)
+        daemon_error_exit("Invalid ONVIF credential file\n");
+    for(size_t i=0;i<split;i++) if(!isalnum((unsigned char)value[i]) && value[i]!='_' && value[i]!='.' && value[i]!='-')
+        daemon_error_exit("Invalid ONVIF credential file\n");
+    size_t length=value.size()-split-2;
+    if(length < 1 || length > 128) daemon_error_exit("Invalid ONVIF credential file\n");
+    for(size_t i=split+1;i<value.size()-1;i++) if((unsigned char)value[i]<32 || (unsigned char)value[i]>126)
+        daemon_error_exit("Invalid ONVIF credential file\n");
+    service_ctx.user=value.substr(0,split);
+    service_ctx.password=value.substr(split+1,length);
+    auth_loaded=true;
+}
+int fullhan_authorize(struct soap *soap)
+{
+    const char *user=(soap->header && soap->header->wsse__Security) ? soap_wsse_get_Username(soap) : NULL;
+    if(soap->header && soap->header->wsse__Security) {
+        if(user && service_ctx.user==user && soap_wsse_verify_Password(soap,service_ctx.password.c_str())==SOAP_OK)
+            return SOAP_OK;
+        return soap_wsse_fault(soap,wsse__FailedAuthentication,"Authentication failed");
+    }
+    if(soap->userid && service_ctx.user==soap->userid && !soap->passwd &&
+       http_da_verify_post(soap,service_ctx.password.c_str())==SOAP_OK) return SOAP_OK;
+    soap->authrealm="LSCamoflash Fullhan";
+    return soap->error=401;
+}
+
 
 
 
